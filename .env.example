# ==========================================
# CONFIGURAÇÕES DO PRICEGLITCH & DROP AGENT
# ==========================================

# Notificações do Telegram
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_ou_canal_aqui

# Tags e IDs de Afiliados
AMAZON_TAG=suatag-20
MERCADOLIVRE_AFFILIATE_TAG=
SHOPEE_AFFILIATE_ID=
LOMADEE_SOURCE_ID=

# IA Gemini para Redação de Copy Dinâmica (Opcional)
GEMINI_API_KEY=

# Limiares de Detecção de Queda e Bug
MIN_PRICE_ALERT=20.0
MIN_DISCOUNT_PERCENT=40.0
GLITCH_DISCOUNT_PERCENT=65.0
Z_SCORE_THRESHOLD=-2.2
