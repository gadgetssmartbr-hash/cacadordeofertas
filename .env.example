# Horário de Disparos no Telegram (7h às 21h)
ALERT_START_HOUR=7
ALERT_END_HOUR=21

# Intervalo do Agente em Minutos

SCAN_INTERVAL_MINUTES=30
REQUEST_DELAY_SECONDS=2.0
DEBUG=false
